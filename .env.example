CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# clef is the verified Flights default; clef-flash remains available as an opt-in.
CLEF_MODEL=clef
# Text entry defaults to Cloudflare and reuses the scoped token above.
TEXT_MODEL=@cf/openai/gpt-oss-20b
# Leave blank to derive the Workers AI /ai/v1 endpoint from the account ID.
TEXT_MODEL_BASE_URL=
TEXT_MODEL_API_KEY=
# omit sends no provider-specific reasoning parameter; none sends reasoning.enabled=false.
TEXT_MODEL_REASONING=low
